# GitHub Personal Access Token
# 申请地址：https://github.com/settings/tokens
# 权限：只需勾选 public_repo（公开仓库读取）即可，无需其他权限。
# 复制本文件为 .env 后填入你自己的 token；.env 已被 .gitignore 忽略，禁止提交。
# 注意：.env.example 本身是入库文件，绝对不要把真实 token 写在这里。
GITHUB_TOKEN=

# 出站代理（可选）。本机 Clash 的混合端口示例：
#   RETRIEVER_PROXY=http://127.0.0.1:7897
# 留空 -> 回退到 config/settings.yaml 的 network.proxy；
# 仍为空 -> 交给 httpx 读取 HTTP_PROXY / HTTPS_PROXY / NO_PROXY。
# 国内直连 raw.githubusercontent.com / codeload.github.com 经常中途卡死，
# 下载类步骤建议显式配置代理。
RETRIEVER_PROXY=

# ---------------------------------------------------------------------------
# LLM（Phase 2：LLM 意图解析，--parser auto|llm 时生效）
# ---------------------------------------------------------------------------
# 任何 OpenAI 兼容的 /chat/completions 端点都可以：DeepSeek / Moonshot / 自建网关。
# 只填 Key 即可，端点与模型默认取 config/settings.yaml 的 llm 段。
# 已经配过 DEEPSEEK_API_KEY 的机器可以直接沿用，LLM_API_KEY 优先级更高。
# 不填也能用：--parser 默认 auto，没有 Key 时自动走规则版解析器，功能不受影响。
LLM_API_KEY=

# 覆盖 config/settings.yaml 的 llm.base_url / llm.model（留空 = 用 YAML 里的值）。
# 例：LLM_BASE_URL=https://api.deepseek.com/v1
#     LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_MODEL=
